# Copy to secrets.yaml and replace every value. Never commit secrets.yaml.
wifi_ssid: "Your Wi-Fi network"
wifi_password: "Your Wi-Fi password"
# Generate: python3 -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
api_key: "REPLACE_WITH_BASE64_KEY"
setup_password: "REPLACE_WITH_PRIVATE_PASSWORD"
# Use your JBL's Bluetooth Classic address, not its BLE advertising address.
speaker_mac: "AA:BB:CC:DD:EE:FF"
